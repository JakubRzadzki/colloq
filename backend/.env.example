# Colloq backend configuration
# Copy to .env and fill in real values. Do NOT commit .env.

# Secret used to sign JWT access tokens. REQUIRED in production.
# Must NOT be the default "change-me-in-production" or the app refuses to start.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production

# PostgreSQL connection string.
DATABASE_URL=postgresql://colloq_user:colloq_password@localhost:5432/colloq_dev

# Absolute (or relative) directory where uploaded files are stored.
UPLOAD_DIR=./uploads

# Public base URL of the API (used to build absolute file URLs).
API_URL=http://localhost:8000

# Upload size limits in bytes.
MAX_FILE_SIZE=10485760   # 10 MB
MAX_IMAGE_SIZE=5242880   # 5 MB

# Per-client default rate limit.
RATE_LIMIT_PER_MINUTE=60/minute

# Comma-separated list of additional allowed CORS origins.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Set to 1 only when running the test suite (disables rate limiting and
# secret-key enforcement). Leave unset in development and production.
# TESTING=1
